# say-6 frontend 환경변수 (로컬 개발용)

# ─────────────────────────────────────────────────────────────
# 백엔드 API 베이스 URL (ECS ALB)
# ─────────────────────────────────────────────────────────────
VITE_BACKEND_URL=http://say2-6team-alb-698170641.ap-northeast-2.elb.amazonaws.com

# 로컬 백엔드로 전환하려면 아래 주석 해제
# VITE_BACKEND_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────
# AWS Cognito JWT 인증 (선택사항 - 데모 모드로 fallback)
# ─────────────────────────────────────────────────────────────
# 미설정 시 자동으로 데모 모드(역할 토글)로 작동합니다.

# VITE_COGNITO_DOMAIN=say-6.auth.ap-northeast-2.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_REDIRECT_URI=http://localhost:3000/demo/auth/callback
# VITE_COGNITO_REGION=ap-northeast-2
# VITE_COGNITO_USER_POOL_ID=ap-northeast-2_xxxxxxxxx

# ─────────────────────────────────────────────────────────────
# API 베이스 (Vite proxy 사용)
# ─────────────────────────────────────────────────────────────
VITE_API_BASE=
